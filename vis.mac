###############################################################
# Visualization driver
###############################################################

# Open OpenGL viewer (recommended)
#
/vis/open OGL 600x600
#/vis/open OGLQt

# Other drivers (optional):
#/vis/open DAWNFILE
#/vis/open VRML2FILE
#/vis/open HepRepFile


###############################################################
# Quiet mode while building the scene
###############################################################
/vis/viewer/set/autoRefresh false
/vis/verbose errors


###############################################################
# Geometry visualization
###############################################################

# Create a new scene
/vis/scene/create

# Add and draw full geometry
/vis/scene/add/volume
/vis/drawVolume


###############################################################
# Viewer configuration
###############################################################

# Background color (optional)
#/vis/viewer/set/background white

# Viewpoint angles (theta, phi)
/vis/viewer/set/viewpointThetaPhi 45 30

# Zoom factor
/vis/viewer/zoom 1.0

# Wireframe mode (optional)
#/vis/viewer/set/style wireframe


###############################################################
# Trajectories
###############################################################

# Add smooth trajectories and draw step points
/vis/scene/add/trajectories smooth

# Draw step points per charge
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2

# Color gammas green
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma green


###############################################################
# Hits (optional)
/vis/scene/add/hits


###############################################################
# Finalize
###############################################################
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
/vis/viewer/flush


